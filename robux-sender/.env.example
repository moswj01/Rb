# ---- ความปลอดภัยของระบบ ----
# โทเคนสำหรับเข้าเว็บแอดมินและเรียก API (อย่างน้อย 24 ตัวอักษร)
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ---- บัญชี Roblox ที่ใช้จ่าย ----
# ค่า cookie .ROBLOSECURITY ของบัญชีผู้จ่าย (ห้ามแชร์/ห้าม commit เด็ดขาด)
ROBLOX_COOKIE=
# (ไม่บังคับ) secret ของแอป Authenticator แบบ base32 ใช้ตอบ 2-step verification ตอนจ่ายเงินกลุ่ม
ROBLOX_TOTP_SECRET=

# ---- วิธีส่ง ----
# group    = จ่ายจากเงินกองกลางกลุ่ม (ผู้รับต้องเป็นสมาชิกกลุ่มและผ่านช่วงรอ)
# gamepass = ซื้อ Game Pass ของผู้รับ (โดนหัก 30%)
DEFAULT_METHOD=group
# ID กลุ่ม (จำเป็นเมื่อใช้วิธี group)
ROBLOX_GROUP_ID=

# ---- วงเงินป้องกันความเสียหาย ----
MAX_PER_ORDER=10000
# วงเงินรวมต่อ 24 ชั่วโมง (นับ Robux ที่จ่ายออกจริง)
DAILY_LIMIT=100000
# หน่วงเวลาระหว่างออเดอร์ (มิลลิวินาที)
SEND_DELAY_MS=3000

# ---- เซิร์ฟเวอร์ ----
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/orders.db
